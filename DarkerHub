                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Loop principal do Auto Coin
task.spawn(function()
    while true do
        task.wait(0.1)
        
        if AutoCoinEnabled and not IsProcessingCoins then
            IsProcessingCoins = true
            
            local noclipConn = nil
            local bv = nil
            
            while AutoCoinEnabled do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                
                local isAlive = true
                if typeof(IsParticipatingAndAlive) == "function" then
                    isAlive = IsParticipatingAndAlive(LocalPlayer)
                end
                
                local matchStarted = (Murder ~= nil and Sheriff ~= nil)
                
                if not hrp or not hum or hum.Health <= 0 or not isAlive or not matchStarted then
                    if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
                    if bv then bv:Destroy() bv = nil end
                    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
                    task.wait(0.5)
                    continue
                end
                
                UpdateCoinCache()
                CoinQueue = GetTop3Coins(hrp.Position)
                
                -- CASO NÃO HAJA MOEDAS NO MAPA:
                if #CoinQueue == 0 then
                    -- Desativa totalmente Voo e Noclip (solta o personagem na física normal)
                    if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
                    if bv then bv:Destroy() bv = nil end
                    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
                    
                    -- Pausa e aguarda no local até que novas moedas surjam
                    while AutoCoinEnabled do
                        task.wait(0.2)
                        char = LocalPlayer.Character
                        hrp = char and char:FindFirstChild("HumanoidRootPart")
                        hum = char and char:FindFirstChild("Humanoid")
                        if not hrp or not hum or hum.Health <= 0 then break end
                        
                        UpdateCoinCache()
                        CoinQueue = GetTop3Coins(hrp.Position)
                        if #CoinQueue > 0 then
                            break -- Sai da pausa e retoma o farm
                        end
                    end
                    
                    continue
                end
                
                local alvo = CoinQueue[1]
                if not IsCoinValid(alvo) then
                    CoinsCache[alvo] = nil
                    continue
                end
                
                -- Reativa Noclip e sustentação de Voo
                if not noclipConn then
                    noclipConn = RunService.Stepped:Connect(function()
                        if char then
                            for _, part in ipairs(char:GetChildren()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                        end
                    end)
                end
                
                if not bv or bv.Parent ~= hrp then
                    if bv then bv:Destroy() end
                    bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                    bv.Velocity = Vector3.zero
                    bv.Parent = hrp
                end
                
                currentCoinTarget = alvo
                ReevaluateRoute = false
                
                -- Posição base da moeda
                local spawnDestino = alvo.Position
                if alvo.Parent and alvo.Parent:IsA("Model") and alvo.Parent.PrimaryPart then
                    spawnDestino = alvo.Parent.PrimaryPart.Position
                elseif alvo.Name == "Coin_Sub" and alvo.Parent and alvo.Parent:FindFirstChild("Coin") then
                    spawnDestino = alvo.Parent.Coin.Position
                end
                
                -- ELEVAÇÃO DE +2 STUDS NO EIXO Y (impede que o HumanoidRootPart afunde os pés no chão)
                local destinoFinal = spawnDestino + Vector3.new(0, 2, 0)
                local speed = (type(AutoCoinSpeed) == "number" and AutoCoinSpeed > 0) and AutoCoinSpeed or 25
                local distanciaAtual = (hrp.Position - destinoFinal).Magnitude
                local tempoViagem = math.max(0.05, distanciaAtual / speed)
                
                if currentCoinTween then currentCoinTween:Cancel() end
                
                currentCoinTween = TweenService:Create(
                    hrp, 
                    TweenInfo.new(tempoViagem, Enum.EasingStyle.Linear), 
                    {CFrame = CFrame.new(destinoFinal)}
                )
                
                currentCoinTween:Play()
                
                -- Execução contínua do voo até o destino
                while currentCoinTween and currentCoinTween.PlaybackState == Enum.PlaybackState.Playing do
                    RunService.Heartbeat:Wait()
                    
                    if not AutoCoinEnabled or ReevaluateRoute then
                        break
                    end
                    
                    if not IsCoinValid(alvo) then
                        ReevaluateRoute = true
                        if currentCoinTween then currentCoinTween:Cancel() end
                        break
                    end
                end
                
                if ReevaluateRoute or not AutoCoinEnabled then
                    if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
                    continue
                end
                
                -- Chegou na moeda
                if IsCoinValid(alvo) then
                    CoinsCache[alvo] = nil
                    
                    local tempoTotal = (type(TempoNaMoeda) == "number" and TempoNaMoeda > 0) and TempoNaMoeda or 0.2
                    local tStart = tick()
                    while tick() - tStart < tempoTotal and AutoCoinEnabled do
                        RunService.Heartbeat:Wait()
                        if ReevaluateRoute then break end
                    end
                    
                    UpdateCoinCache()
                    CoinQueue = GetTop3Coins(hrp.Position)
                end
            end
            
            -- Limpeza completa das conexões e física
            if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
            if bv then bv:Destroy() bv = nil end
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
            
            IsProcessingCoins = false
        end
    end
end)

local function GetClosestPlayerToCenter()
    local closestPlayer = nil
    local shortestDistance = FovSize
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myRole = GetPlayerRole(LocalPlayer)

    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local role = GetPlayerRole(p)
            local canTarget = false

            if myRole == "Murderer" then
                canTarget = true
            else
                if role == "Murderer" then
                    canTarget = true
                end
            end

            if canTarget then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = p.Character.Head
                    end
                end
            end
        end
    end
    return closestPlayer
end

