local CoinsCache = {}
local BlacklistedCoins = {}
local currentCoinTween = nil
local currentCoinTarget = nil
local IsProcessingCoins = false
local ReevaluateRoute = false
local coinAddedConnection = nil
local coinRemovedConnection = nil

-- Valida se a moeda existe e não está na blacklist
local function IsCoinValid(coin)
    return coin 
        and coin.Parent 
        and coin:IsA("BasePart")
        and coin.Transparency < 1 
        and coin:IsDescendantOf(workspace)
        and not BlacklistedCoins[coin]
end

-- Escaneamento completo do mapa
local function InitialMapScan()
    table.clear(CoinsCache)
    table.clear(BlacklistedCoins) -- Limpa a blacklist ao escanear o mapa de novo
    local areaDeBusca = workspace:FindFirstChild("NormalMaps") or workspace:FindFirstChild("Map") or workspace
    for _, obj in ipairs(areaDeBusca:GetDescendants()) do
        if IsCoinValid(obj) then
            local nome = string.lower(obj.Name)
            if (nome:find("coin") or nome:find("gold") or nome:find("token")) and obj.Size.X <= 6 then
                local model = obj:FindFirstAncestorOfClass("Model")
                if model and not model:FindFirstChild("Lobby") then
                    CoinsCache[obj] = true
                end
            end
        end
    end
end

-- Função para pegar sempre a moeda mais perto
local function GetNearestCoin(centerPos)
    local nearest = nil
    local minDist = math.huge
    
    for coin in pairs(CoinsCache) do
        if IsCoinValid(coin) then
            local dist = (centerPos - coin.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = coin
            end
        else
            CoinsCache[coin] = nil
        end
    end
    return nearest
end

