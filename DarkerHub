                    if hrp and currentCoinTarget and IsCoinValid(currentCoinTarget) then
                        local currentDist = (hrp.Position - currentCoinTarget.Position).Magnitude
                        local newDist = (hrp.Position - obj.Position).Magnitude
                        
                        if newDist < currentDist - 2 then
                            ReevaluateRoute = true
                            if currentCoinTween then
