local function ExecutarDisparo()
    local Character = LocalPlayer.Character
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    if not Character or not Backpack then return end

    local gunInBackpack = Backpack:FindFirstChild("Gun") or Backpack:FindFirstChild("Revolver")
    local gunInChar = Character:FindFirstChild("Gun") or Character:FindFirstChild("Revolver")
    local gun = gunInChar or gunInBackpack

    if not gun then 
        warn("[Shoot System] Você não possui a arma!")
        return 
    end

    if gun.Parent == Backpack then
        gun.Parent = Character
        task.wait(0.05)
    end

    local murderer = murdererAtual or AtualizarMurderer()
    if not murderer or not murderer.Character then 
        warn("[Shoot System] Murderer não encontrado!")
        return 
    end

    local targetPart = murderer.Character:FindFirstChild("HumanoidRootPart") 
        or murderer.Character:FindFirstChild("UpperTorso")
    local humanoid = murderer.Character:FindFirstChildOfClass("Humanoid")
    local myRoot = Character:FindFirstChild("HumanoidRootPart")

    if targetPart and humanoid and humanoid.Health > 0 and myRoot then
        local shootEvent = gun:FindFirstChild("Shoot") or gun:FindFirstChild("KnifeServer") or ReplicatedStorage:FindFirstChild("ShootGun", true)

        if shootEvent and shootEvent:IsA("RemoteEvent") then
            local originPos = myRoot.Position + Vector3.new(0, 1.5, 0)
            local targetPos = CalcularPosicaoPrevista(targetPart)

            local realOrigin = CFrame.lookAt(originPos, targetPos)
            local realTarget = CFrame.new(targetPos)

            shootEvent:FireServer(realOrigin, realTarget)

            if typeof(PararAnimacoesDeTiro) == "function" then
                pcall(function()
                    PararAnimacoesDeTiro(Character)
                end)
            end
        end
    end
end

