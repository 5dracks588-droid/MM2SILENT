            GhostButton.Size = UDim2.new(0, 70, 0, 70)
            GhostButton.Position = UDim2.new(0.5, -35, 0.80, 0)
            GhostButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            GhostButton.BackgroundTransparency = 0.5
            GhostButton.RichText = true
            GhostButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            GhostButton.Text = ghostModeActive and "<font color=\"#FFFFFF\">Ghost</font>\n<font color=\"#00FF00\">on</font>" or "<font color=\"#FFFFFF\">Ghost</font>\n<font color=\"#FF0000\">off</font>"
            GhostButton.TextSize = 14
            GhostButton.Font = Enum.Font.SourceSansBold
            GhostButton.Active = true
            GhostButton.Parent = GhostButtonGui

            currentGhostButton = GhostButton

            local UICorner = Instance.new("UICorner")
            UICorner.CornerRadius = UDim.new(0, 14)
            UICorner.Parent = GhostButton

            local UIStroke = Instance.new("UIStroke")
            UIStroke.Thickness = 2
            UIStroke.Color = Color3.fromRGB(255, 255, 255)
            UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            UIStroke.Parent = GhostButton

            local StrokeGradient = Instance.new("UIGradient")
            StrokeGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 150, 150)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
            })
            StrokeGradient.Parent = UIStroke

            task.spawn(function()
                local rot = 0
                while GhostButton and GhostButton.Parent do
                    rot = (rot + 3) % 360
                    if StrokeGradient and StrokeGradient.Parent then
                        StrokeGradient.Rotation = rot
                    end
                    RunService.Heartbeat:Wait()
                end
            end)

            local dragging, dragStartMouse, dragStartPos
            GhostButton.InputBegan:Connect(function(input)
                if not canMoveButton then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
                    dragStartPos = GhostButton.Position
                    
                    local conn, endConn
                    conn = UserInputService.InputChanged:Connect(function(moveInput)
                        if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and dragging then
                            local delta = Vector2.new(moveInput.Position.X, moveInput.Position.Y) - dragStartMouse
                            GhostButton.Position = UDim2.new(dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X, dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y)
                        end
                    end)
                    
                    endConn = UserInputService.InputEnded:Connect(function(endInput)
                        if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                            if conn then conn:Disconnect() end
                            if endConn then endConn:Disconnect() end
                        end
                    end)
                end
            end)

            GhostButton.MouseButton1Click:Connect(function()
                setGhostState(not ghostModeActive)
            end)
        else
            currentGhostButton = nil
            if CoreGui:FindFirstChild("GhostButtonGui") then
                CoreGui.GhostButtonGui:Destroy()
            end
        end
    end
})

PlayerTab:Toggle({
    Title = "Drag button",
    Default = false,
    Callback = function(Value)
        canMoveButton = Value
    end
})
