local function prepareGhostClone(model)
    for _, v in pairs(model:GetDescendants()) do
        if v:IsA("Animator") or v:IsA("AnimationController") or v:IsA("Script") or v:IsA("LocalScript") then
            v:Destroy()
        end
    end

    for _, v in pairs(model:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.Anchored = true
            if v.Name == "HumanoidRootPart" or v.Name == "CollisionBox" then
                v.Transparency = 1
            else
                v.Transparency = 0.5
                v.LocalTransparencyModifier = 0
            end
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 0.5
        elseif v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
            v.Enabled = true
        end
    end
end

local function buildPartPairs(realModel, cloneModel)
    table.clear(partPairs)
    local realFullName = realModel:GetFullName()
    
    for _, realPart in ipairs(realModel:GetDescendants()) do
        if realPart:IsA("BasePart") then
            local path = realPart:GetFullName():sub(#realFullName + 2)
            local current = cloneModel
            
            for name in string.gmatch(path, "[^.]+") do
                if current then
                    current = current:FindFirstChild(name)
                end
            end
            
            if current and current:IsA("BasePart") then
                partPairs[realPart] = current
            else
                for _, cp in ipairs(cloneModel:GetDescendants()) do
                    if cp:IsA("BasePart") and cp.Name == realPart.Name then
                        partPairs[realPart] = cp
                        break
                    end
                end
            end
        end
    end
end

-- Declaração antecipada da função
local setGhostState 

local function checkTeleport()
    if not ghostModeActive or isUpdatingGhostCFrame then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local currentPos = hrp.Position

    if lastKnownSkyPos == Vector3.zero then
        lastKnownSkyPos = currentPos
        return
    end

    local dist = (currentPos - lastKnownSkyPos).Magnitude

    if dist > 100 then
        -- Mantém o Ghost ativado ao ser teleportado pelo servidor (muda de mapa/lobby)
        isUpdatingGhostCFrame = true
        local newGroundPos = currentPos
        
        hrp.CFrame = CFrame.new(newGroundPos) + ghostOffset
        lastKnownSkyPos = hrp.Position

        if ghostClone then
            local cloneHRP = ghostClone:FindFirstChild("HumanoidRootPart")
            if cloneHRP then
                cloneHRP.CFrame = CFrame.new(newGroundPos)
            end
        end

        for realPart, clonePart in pairs(partPairs) do
            if realPart and realPart.Parent and clonePart and clonePart.Parent then
                clonePart.CFrame = realPart.CFrame - ghostOffset
            end
        end

        isUpdatingGhostCFrame = false
        return
    elseif currentPos.Y < (ghostOffset.Y - 200) then
        isUpdatingGhostCFrame = true
        
        hrp.CFrame = hrp.CFrame + ghostOffset
        lastKnownSkyPos = hrp.Position

        for realPart, clonePart in pairs(partPairs) do
            if realPart and realPart.Parent and clonePart and clonePart.Parent then
                clonePart.CFrame = realPart.CFrame - ghostOffset
            end
        end

        isUpdatingGhostCFrame = false
    else
        lastKnownSkyPos = currentPos
    end
end

-- Função principal de ativação/desativação
setGhostState = function(state, skipTeleportBack)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    -- Limpa conexões antigas
    RunService:UnbindFromRenderStep("GhostSyncVisual")
    if ghostCamConn then ghostCamConn:Disconnect() ghostCamConn = nil end
    if ghostCFrameConn then ghostCFrameConn:Disconnect() ghostCFrameConn = nil end
    if ghostDiedConn then ghostDiedConn:Disconnect() ghostDiedConn = nil end

    ghostModeActive = state
    updateGhostButtonUI(state)

    if ghostToggle then
        if typeof(ghostToggle.SetValue) == "function" then
            ghostToggle:SetValue(state)
        elseif typeof(ghostToggle.Set) == "function" then
            ghostToggle:Set(state)
        end
    end

    if ghostModeActive then
        -- Remove foco de morte anterior se existir
        if deathCamPart then
            deathCamPart:Destroy()
            deathCamPart = nil
        end

        isUpdatingGhostCFrame = true
        local hrp = char.HumanoidRootPart
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        ghostOffset = Vector3.new(10000, 1000, 10000)

        local initialCFrame = hrp.CFrame

        -- DETECÇÃO DE MORTE DO PERSONAGEM REAL
        if humanoid then
            ghostDiedConn = humanoid.Died:Connect(function()
                -- Cria um ponto invisível onde o clone estava para prender a câmera lá
                if ghostClone and ghostClone:FindFirstChild("HumanoidRootPart") then
                    local lastCloneCFrame = ghostClone.HumanoidRootPart.CFrame
                    
                    deathCamPart = Instance.new("Part")
                    deathCamPart.Name = "GhostDeathCamFocus"
                    deathCamPart.Size = Vector3.new(1, 1, 1)
                    deathCamPart.Transparency = 1
                    deathCamPart.CanCollide = false
                    deathCamPart.Anchored = true
                    deathCamPart.CFrame = lastCloneCFrame
                    deathCamPart.Parent = workspace

                    workspace.CurrentCamera.CameraSubject = deathCamPart
                end
                
                -- Desativa o Ghost Mode sem puxar o corpo morto de volta
                setGhostState(false, true)
            end)
        end

        char.Archivable = true
        ghostClone = char:Clone()
        
        local cloneHRP = ghostClone:FindFirstChild("HumanoidRootPart")
        if cloneHRP then 
            ghostClone.PrimaryPart = cloneHRP 
            cloneHRP.CFrame = initialCFrame
        end

        prepareGhostClone(ghostClone)
        buildPartPairs(char, ghostClone)
        
        ghostClone.Parent = workspace

        -- Ancoragem no céu
        hrp.Anchored = true
        hrp.CFrame = initialCFrame + ghostOffset
        lastKnownSkyPos = hrp.Position

        task.delay(0.01, function()
            if ghostModeActive and hrp and hrp.Parent then
                hrp.Anchored = false
            end
        end)

        local cloneHumanoid = ghostClone:FindFirstChildOfClass("Humanoid")
        if cloneHumanoid then
            workspace.CurrentCamera.CameraSubject = cloneHumanoid
        end

        isUpdatingGhostCFrame = false

        ghostCFrameConn = hrp:GetPropertyChangedSignal("CFrame"):Connect(checkTeleport)

        ghostCamConn = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
            if ghostModeActive and ghostClone and ghostClone:FindFirstChildOfClass("Humanoid") then
                local targetSubject = ghostClone:FindFirstChildOfClass("Humanoid")
                if workspace.CurrentCamera.CameraSubject ~= targetSubject then
                    workspace.CurrentCamera.CameraSubject = targetSubject
                end
            end
        end)

        RunService:BindToRenderStep("GhostSyncVisual", Enum.RenderPriority.Camera.Value - 1, function()
            local currentChar = LocalPlayer.Character
            if not ghostClone or not currentChar or not currentChar:FindFirstChild("HumanoidRootPart") then return end
            
            checkTeleport()

            local realHRP = currentChar.HumanoidRootPart

            if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
                local camCFrame = workspace.CurrentCamera.CFrame
                local lookVector = camCFrame.LookVector
                local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
                if flatLook.Magnitude > 0.001 then
                    realHRP.CFrame = CFrame.lookAt(realHRP.Position, realHRP.Position + flatLook.Unit)
                end
            end

            for realPart, clonePart in pairs(partPairs) do
                if realPart and realPart.Parent and clonePart and clonePart.Parent then
                    clonePart.CFrame = realPart.CFrame - ghostOffset
                    if clonePart.Name ~= "HumanoidRootPart" and clonePart.Name ~= "CollisionBox" then
                        clonePart.LocalTransparencyModifier = 0
                        clonePart.Transparency = 0.5
                    end
                end
            end
        end)
    else
        -- DESTRUIÇÃO DO GHOST
        if ghostClone then ghostClone:Destroy() ghostClone = nil end
        table.clear(partPairs)

        local currentChar = LocalPlayer.Character
        if currentChar and currentChar:FindFirstChild("HumanoidRootPart") then
            isUpdatingGhostCFrame = true
            
            if not skipTeleportBack then
                currentChar.HumanoidRootPart.CFrame = currentChar.HumanoidRootPart.CFrame - ghostOffset
            end
            
            currentChar.HumanoidRootPart.Anchored = false 
            isUpdatingGhostCFrame = false
            
            local realHumanoid = currentChar:FindFirstChildOfClass("Humanoid")
            -- Só devolve a câmera para o personagem real SE ELE ESTIVER VIVO
            if realHumanoid and realHumanoid.Health > 0 then
                workspace.CurrentCamera.CameraSubject = realHumanoid
            end
        end

        lastKnownSkyPos = Vector3.zero
    end
end

