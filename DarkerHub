local function GuiarBalaEmTempoReal(bulletPart, murdererChar)
    if bulletPart:IsA("BasePart") then
        bulletPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        bulletPart.Velocity = Vector3.new(0, 0, 0)
        bulletPart.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    end

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not bulletPart or not bulletPart.Parent or not murdererChar or not murdererChar:FindFirstChild("HumanoidRootPart") then
            if connection then connection:Disconnect() end
            return
        end

        local targetPart = murdererChar:FindFirstChild("HumanoidRootPart") 
            or murdererChar:FindFirstChild("UpperTorso") 
            
        if targetPart then
            local currentBulletPos = bulletPart.Position
            local liveTargetPos = targetPart.Position
            
            local direction = (liveTargetPos - currentBulletPos)
            local distance = direction.Magnitude
            
            if distance > 2 then
                local speed = 35
                bulletPart.CFrame = CFrame.new(currentBulletPos + (direction.Unit * math.min(speed, distance)), liveTargetPos)
            else
                bulletPart.CFrame = CFrame.new(liveTargetPos)
                pcall(function()
                    firetouchinterest(targetPart, bulletPart, 0)
                    task.wait()
                    firetouchinterest(targetPart, bulletPart, 1)
                end)
                if connection then connection:Disconnect() end
            end
        end
    end)
end

