local function UpdateThrowButtonState()
    if not ThrowButtonGui or not ThrowButtonGui:FindFirstChild("ThrowButton") then return end
    local ThrowButton = ThrowButtonGui.ThrowButton
    
    ThrowButton.Size = ThrowBtnSize
    ThrowButton.Position = ThrowBtnPos
    
    local outline = ThrowButton:FindFirstChild("ResizeOutline")
    if ThrowResizeActive then
        if not outline then
            outline = Instance.new("UIStroke")
            outline.Name = "ResizeOutline"
            outline.Thickness = 2
            outline.Color = Color3.fromRGB(0, 0, 0)
            outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            outline.Parent = ThrowButton
        end
    else
        if outline then outline:Destroy() end
    end
    
    local handle = ThrowButton:FindFirstChild("ResizeHandle")
    if ThrowResizeActive then
        if not handle then
            handle = Instance.new("TextButton")
            handle.Name = "ResizeHandle"
            handle.Size = UDim2.new(0, 18, 0, 18)
            handle.Position = UDim2.new(1, 0, 1, 0)
            handle.AnchorPoint = Vector2.new(0.5, 0.5)
            handle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            handle.Text = "+"
            handle.TextColor3 = Color3.fromRGB(255, 255, 255)
            handle.TextSize = 14
            handle.Font = Enum.Font.SourceSansBold
            handle.Parent = ThrowButton
            
            local hCorner = Instance.new("UICorner")
            hCorner.CornerRadius = UDim.new(0, 4)
            hCorner.Parent = handle

            local draggingResize = false
            local resizeStartMouse = Vector2.zero
            handle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingResize = true
                    resizeStartMouse = Vector2.new(input.Position.X, input.Position.Y)
                    local resizeStartSize = Vector2.new(ThrowButton.AbsoluteSize.X, ThrowButton.AbsoluteSize.Y)
                    
                    local conn, endConn
                    conn = UserInputService.InputChanged:Connect(function(moveInput)
                        if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and draggingResize then
                            local delta = Vector2.new(moveInput.Position.X, moveInput.Position.Y) - resizeStartMouse
                            local newW = math.clamp(math.floor(resizeStartSize.X + delta.X), 20, 200)
                            local newH = math.clamp(math.floor(resizeStartSize.Y + delta.Y), 20, 200)
                            ThrowBtnSize = UDim2.new(0, newW, 0, newH)
                            ThrowButton.Size = ThrowBtnSize
                        end
                    end)
                    
                    endConn = UserInputService.InputEnded:Connect(function(endInput)
                        if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                            draggingResize = false
                            if conn then conn:Disconnect() end
                            if endConn then endConn:Disconnect() end
                        end
                    end)
                end
            end)
        end
    else
        if handle then handle:Destroy() end
    end
end

