local murdererAtual = nil

local function AtualizarMurderer()
    -- ETAPA 1: Consulta GetPlayerData (Início da partida / < 10s)
    local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if getPlayerData and getPlayerData:IsA("RemoteFunction") then
        local success, data = pcall(function()
            return getPlayerData:InvokeServer()
        end)

        if success and type(data) == "table" then
            for playerName, info in pairs(data) do
                local role = nil
                if type(info) == "table" then
                    role = info.Role or info.role
                elseif type(info) == "string" then
                    role = info
                end

                if role == "Murderer" or role == "Murder" then
                    local p = Players:FindFirstChild(playerName)
                    if p and p ~= LocalPlayer and p.Character then
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            return p
                        end
                    end
                end
            end
        end
    end

    -- ETAPA 2: Verificação por Inventário (Após a faca spawnar)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local backpack = player:FindFirstChild("Backpack")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if hum and hum.Health > 0 then
                local charKnife = char:FindFirstChild("Knife")
                local backpackKnife = backpack and backpack:FindFirstChild("Knife")

                if charKnife or backpackKnife then
                    return player
                end
            end
        end
    end

    return nil
end

