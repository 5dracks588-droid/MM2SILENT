            local bv = nil
            
            while AutoCoinEnabled do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                
                -- Checa se está vivo usando pcall pra evitar erros caso a função falhe
                local isAlive = true
                if typeof(IsParticipatingAndAlive) == "function" then
                    pcall(function() isAlive = IsParticipatingAndAlive(LocalPlayer) end)
                end
                
                -- SE ESTIVER MORTO, NO LOBBY, OU RESETOU:
                if not hrp or not hum or hum.Health <= 0 or not isAlive then
                    if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
                    if bv then bv:Destroy() bv = nil end
                    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
                    task.wait(0.5)
                    continue -- Fica esperando você renascer pacientemente
                end
                
                ReevaluateRoute = false
                local alvo = GetNearestCoin(hrp.Position)
                
                -- SE ACABARAM AS MOEDAS:
                if not alvo then
                    if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
                    if bv then bv:Destroy() bv = nil end
                    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
                    
                    -- Fica escaneando até o novo mapa carregar ou nascer moeda
                    while AutoCoinEnabled do
                        task.wait(1)
                        local currChar = LocalPlayer.Character
                        local currHrp = currChar and currChar:FindFirstChild("HumanoidRootPart")
                        if not currHrp or not currChar:FindFirstChild("Humanoid") or currChar.Humanoid.Health <= 0 then 
                            break -- Se morrer enquanto espera, sai e volta pro inicio do loop
                        end
                        
                        InitialMapScan() 
                        alvo = GetNearestCoin(currHrp.Position)
                        if alvo then break end
                    end
                    continue
                end
                
                -- NOCLIP CORRIGIDO (Pega o personagem ATUAL, e não o antigo)
                if not noclipConn then
                    noclipConn = RunService.Stepped:Connect(function()
                        local cChar = LocalPlayer.Character
                        if cChar then
                            for _, part in ipairs(cChar:GetChildren()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                        end
                    end)
                end
                
                -- ANTI-GRAVIDADE
                if not bv or bv.Parent ~= hrp then
                    if bv then bv:Destroy() end
                    bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                    bv.Velocity = Vector3.zero
                    bv.Parent = hrp
                end
                
                currentCoinTarget = alvo
                
                -- POSIÇÃO EXATA DA MOEDA (Offset zerado como você pediu)
                local destinoFinal = alvo.Position
                if alvo.Parent and alvo.Parent:IsA("Model") and alvo.Parent.PrimaryPart then
                    destinoFinal = alvo.Parent.PrimaryPart.Position
                elseif alvo.Name == "Coin_Sub" and alvo.Parent and alvo.Parent:FindFirstChild("Coin") then
                    destinoFinal = alvo.Parent.Coin.Position
                end
                
                local speed = (type(AutoCoinSpeed) == "number" and AutoCoinSpeed > 0) and AutoCoinSpeed or 25
                local distanciaAtual = (hrp.Position - destinoFinal).Magnitude
                local tempoViagem = math.max(0.05, distanciaAtual / speed)
                
                if currentCoinTween then currentCoinTween:Cancel() end
                currentCoinTween = TweenService:Create(
                    hrp, 
                    TweenInfo.new(tempoViagem, Enum.EasingStyle.Linear), 
                    {CFrame = CFrame.new(destinoFinal) * hrp.CFrame.Rotation}
                )
                currentCoinTween:Play()
                
                -- TEMPO LIMITE / ANTI-TRAVAMENTO
                local tempoLimite = tempoViagem + 1.5 
                local tempoInicio = tick()
                local travou = false
                
                while currentCoinTween and currentCoinTween.PlaybackState == Enum.PlaybackState.Playing do
                    RunService.Heartbeat:Wait()
                    
                    if not AutoCoinEnabled or ReevaluateRoute then break end
                    
                    -- Se alguém pegou a moeda no meio do caminho
                    if not IsCoinValid(alvo) then
                        ReevaluateRoute = true
                        if currentCoinTween then currentCoinTween:Cancel() end
                        break
                    end
                    
                    -- Se você morreu no meio do caminho (alguém te matou)
                    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") or LocalPlayer.Character.Humanoid.Health <= 0 then
                        ReevaluateRoute = true
                        if currentCoinTween then currentCoinTween:Cancel() end
                        break
                    end
                    
                    -- Se o tempo limite estourou (você enroscou em algo impossível de passar)
                    if tick() - tempoInicio > tempoLimite then
                        travou = true
                        ReevaluateRoute = true
                        if currentCoinTween then currentCoinTween:Cancel() end
                        break
                    end
                end
                
                if not AutoCoinEnabled then continue end
                
                -- Se a moeda ficou inalcançável (preso na parede)
                if travou then
                    BlacklistedCoins[alvo] = true
                    CoinsCache[alvo] = nil
                    continue
                end
                
                -- CHEGOU NA MOEDA (Espera ela coletar de fato)
                if not ReevaluateRoute and IsCoinValid(alvo) then
                    CoinsCache[alvo] = nil
                    local tempoTotal = (type(TempoNaMoeda) == "number" and TempoNaMoeda > 0) and TempoNaMoeda or 0.2
                    local tStart = tick()
                    while tick() - tStart < tempoTotal and AutoCoinEnabled do
                        RunService.Heartbeat:Wait()
                        if ReevaluateRoute then break end
                    end
                end
            end
            
            -- Limpeza geral ao desligar o Toggle
            if currentCoinTween then currentCoinTween:Cancel() currentCoinTween = nil end
            if bv then bv:Destroy() bv = nil end
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
            
            IsProcessingCoins = false
        elseif not AutoCoinEnabled then
            -- Garante que o script destrave se o Toggle for desligado bruscamente
            IsProcessingCoins = false
        end
    end
end)

local function GetClosestPlayerToCenter()
    local closestPlayer = nil
    local shortestDistance = FovSize
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myRole = GetPlayerRole(LocalPlayer)

    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local role = GetPlayerRole(p)
            local canTarget = false

            if myRole == "Murderer" then
                canTarget = true
            else
                if role == "Murderer" then
                    canTarget = true
                end
            end

            if canTarget then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = p.Character.Head
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function IsPlayerAlive(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if roles and roles[player.Name] then
        local playerData = roles[player.Name]
        return not playerData.Killed and not playerData.Dead
    end
    return true
end

local function UpdateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local highlight = char:FindFirstChild("ESPHighlight")

            if EspEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.Parent = char
                end

                -- Cor padrão para Inocentes / Mortos / Não participantes: Verde
                local color = Color3.fromRGB(0, 255, 0) 

                if IsParticipatingAndAlive(p) then
                    local role = GetPlayerRole(p)
                    if role == "Murderer" then
                        color = Color3.fromRGB(255, 0, 0) -- Vermelho
                    elseif role == "Sheriff" then
                        color = Color3.fromRGB(0, 0, 255) -- Azul
                    end
                end

                highlight.FillColor = color
                highlight.OutlineColor = color
                highlight.FillTransparency = 0.5    -- Transparência do meio (preenchimento)
                highlight.OutlineTransparency = 1 -- Transparência da borda (contorno)
            else
                if highlight then highlight:Destroy() end
            end
        elseif p == LocalPlayer then
            local highlight = p.Character and p.Character:FindFirstChild("ESPHighlight")
            if highlight then highlight:Destroy() end
        end
    end
end

