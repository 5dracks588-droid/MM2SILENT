-- CÁLCULO DA POSIÇÃO PREVISTA (EXATAMENTE PING * MULTIPLICADOR)
-------------------------------------------------------------
local function ObterPing()
    local ping = 0
    pcall(function()
        if LocalPlayer.GetNetworkPing then
            ping = LocalPlayer:GetNetworkPing()
        end
    end)
    return (ping and ping > 0) and ping or 0.05
end

local function CalcularPosicaoPrevista(targetPart)
    if not targetPart then return Vector3.zero end

    local targetPos = targetPart.Position
    local ping = ObterPing()
    local velocidade = targetPart.AssemblyLinearVelocity or targetPart.Velocity or Vector3.new(0,0,0)

    -- Isola a velocidade nos eixos X e Z e aplica o multiplicador de ping
    if velocidade.Magnitude > 0.5 then
        local offset = Vector3.new(velocidade.X, 0, velocidade.Z) * ping * MULTIPLICADOR_PING
        targetPos = targetPos + offset
    end

    return targetPos
end

