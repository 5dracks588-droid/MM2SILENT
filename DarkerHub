                    FpsLabel.Text = "FPS " .. frames
                    frames = 0
                    lastUpdate = tick()
                end
                RunService.Heartbeat:Wait()
            end
        end)

        FpsGui = ScreenGui
    else
        if FpsGui then
            FpsGui:Destroy()
            FpsGui = nil
